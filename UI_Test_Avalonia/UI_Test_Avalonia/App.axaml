<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             x:Class="UI_Test_Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush">#121212</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="SurfaceBrush">#1E1E1E</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceBorderBrush">#2D2D2D</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceHoverBrush">#2A2A2A</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfacePressedBrush">#171717</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="ModernCardBrush">#1E1E1E</SolidColorBrush>
                    <SolidColorBrush x:Key="ModernCardBorderBrush">#2D2D2D</SolidColorBrush>
                    <SolidColorBrush x:Key="ModernCardHoverBrush">#2A2A2A</SolidColorBrush>
                    <SolidColorBrush x:Key="ModernCardPressedBrush">#171717</SolidColorBrush>

                    <SolidColorBrush x:Key="TextPrimaryBrush">#EDEDED</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondaryBrush">#A0A0A0</SolidColorBrush>
                </ResourceDictionary>
                
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush">#EFEFED</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="SurfaceBrush">#F8F8F6</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceBorderBrush">#E0E0DE</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceHoverBrush">#F0F0EE</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfacePressedBrush">#E8E8E6</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="ModernCardBrush">#F8F8F6</SolidColorBrush>
                    <SolidColorBrush x:Key="ModernCardBorderBrush">#E0E0DE</SolidColorBrush>
                    <SolidColorBrush x:Key="ModernCardHoverBrush">#F0F0EE</SolidColorBrush>
                    <SolidColorBrush x:Key="ModernCardPressedBrush">#E8E8E6</SolidColorBrush>

                    <SolidColorBrush x:Key="TextPrimaryBrush">#2C3E50</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondaryBrush">#697A8D</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button.ModernCard /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ModernCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ModernCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style Selector="Button.ModernCard">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ModernCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ModernCardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
        </Style>
        <Style Selector="Button.ModernCard:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.01)"/>
        </Style>

        <Style Selector="Button.ModernCard:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ModernCardPressedBrush}"/>
            <Setter Property="BorderBrush" Value="#3b82f6"/>
        </Style>
        <Style Selector="Button.ModernCard:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <Style Selector="Button.ModernCard.Accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#354a70"/>
            <Setter Property="BorderBrush" Value="#3b82f6"/>
        </Style>

        <Style Selector="Button.ModernCard.Accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#253550"/>
            <Setter Property="BorderBrush" Value="#2563eb"/>
        </Style>

        <Style Selector="Button.ModernCard.Accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0f172a"/> 
            <Setter Property="BorderBrush" Value="#3b82f6"/> 
        </Style>
        
    </Application.Styles>
</Application>