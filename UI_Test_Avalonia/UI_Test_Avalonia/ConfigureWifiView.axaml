<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="UI_Test_Avalonia.ConfigureWifiView">

    <Grid Margin="30" RowDefinitions="Auto, *">
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,25">
            <Button Name="BackButton" VerticalAlignment="Center" Classes="ModernCard" Padding="12,8">
                <fa:SymbolIcon Symbol="Back" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Konfiguracja Urządzenia" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Połącz i skonfiguruj platformy ESP32" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource SurfaceBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="16" 
                    Padding="30" 
                    Width="500" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top"
                    Margin="0,10,0,30">
    
                <StackPanel Spacing="20">
                    
                    <StackPanel Spacing="10">
                        <TextBlock Text="Krok 1: Wyszukiwanie urządzeń" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        
                        <Button Content="Skanuj porty ESP" 
                                Classes="ModernCard" 
                                Padding="15,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="8"
                                Click="ScanButton_Click" />
                        
                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="8" Padding="12,10" Margin="0,5,0,0">
                            <Grid ColumnDefinitions="Auto, *">
                                <fa:SymbolIcon Grid.Column="0" Symbol="Important" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="StatusTextBlock" 
                                           Text="Status: Oczekiwanie na skanowanie..." 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           FontSize="13" 
                                           VerticalAlignment="Center" 
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Separator Background="{DynamicResource SurfaceBorderBrush}" Margin="0,5"/>

                    <StackPanel x:Name="InputPanel" Spacing="15" IsEnabled="False">
                        <TextBlock Text="Krok 2: Ustawienia sieciowe" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        
                        <StackPanel Spacing="6">
                            <TextBlock Text="SSID (Nazwa sieci WiFi):" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="SsidTextBox" Watermark="Wprowadź nazwę sieci..." Height="38">
                                <TextBox.InnerLeftContent>
                                    <fa:SymbolIcon Symbol="Wifi4" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </TextBox.InnerLeftContent>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Hasło WiFi:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="PasswordTextBox" PasswordChar="*" Watermark="Wprowadź hasło..." Height="38">
                                <TextBox.InnerLeftContent>
                                    <fa:SymbolIcon Symbol="Permissions" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </TextBox.InnerLeftContent>
                            </TextBox>
                        </StackPanel>
                        
                        <StackPanel Spacing="6">
                            <TextBlock Text="Adres IP Brokera MQTT (Ten komputer):" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="MqttIpTextBox" Watermark="np. 192.168.1.50" Height="38">
                                <TextBox.InnerLeftContent>
                                    <fa:SymbolIcon Symbol="Target" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </TextBox.InnerLeftContent>
                            </TextBox>
                        </StackPanel>
                        
                        <Button Content="Wyślij konfigurację do urządzeń" 
                                Classes="ModernCard"
                                Padding="15,12"
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontWeight="Bold"
                                CornerRadius="8"
                                Margin="0,15,0,0" 
                                Click="ConnectButton_Click" />
    
                        <Button Name="DisconnectButton" 
                                Content="Rozłącz" 
                                Classes="ModernCard"
                                Click="DisconnectButton_Click"
                                Width="150"
                                Height="40"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                        
                            <Button.Styles>
                                <Style Selector="Button.ModernCard:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource ModernCardPressedBrush}"/> 
                                    <Setter Property="BorderBrush" Value="#E53935"/> 
                                </Style>
                            </Button.Styles>
                        </Button>

                    </StackPanel>
                    
                </StackPanel>
            </Border>
        </ScrollViewer>
        
    </Grid>
</UserControl>