<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="UI_Test_Avalonia.ConfigureWifiView">

    <Grid Margin="30" RowDefinitions="Auto, *">
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,25">
            <Button Name="BackButton" VerticalAlignment="Center" Padding="8,6" Theme="{StaticResource TransparentButton}">
                <fa:SymbolIcon Symbol="Back" FontSize="20" Foreground="White"/>
            </Button>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Konfiguracja Urządzenia" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Połącz i skonfiguruj platformy ESP32" FontSize="14" Foreground="Gray"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="#2d2d2d" 
        BorderBrush="#3d3d3d" 
        BorderThickness="1" 
        CornerRadius="16" 
        Padding="30" 
        MaxWidth="550" 
        HorizontalAlignment="Center" 
        VerticalAlignment="Top"
        Margin="0,10,0,30">
    
    <StackPanel Spacing="20">
        
        <StackPanel Spacing="10">
            <TextBlock Text="Krok 1: Wyszukiwanie urządzeń" FontWeight="SemiBold" FontSize="15" Foreground="White"/>
            
            <Button Content="Skanuj porty ESP" 
                    Classes="Accent" 
                    Height="40"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    CornerRadius="8"
                    Click="ScanButton_Click" />
            
            <Border Background="#222222" CornerRadius="8" Padding="12,10" Margin="0,5,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <fa:SymbolIcon Symbol="Important" FontSize="16" VerticalAlignment="Center" Foreground="Gray"/>
                    <TextBlock x:Name="StatusTextBlock" 
                               Text="Status: Oczekiwanie na skanowanie..." 
                               Foreground="Gray" 
                               FontSize="13" 
                               VerticalAlignment="Center" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Separator Background="#3d3d3d" Margin="0,5"/>

        <StackPanel x:Name="InputPanel" Spacing="15" IsEnabled="False">
            <TextBlock Text="Krok 2: Ustawienia sieciowe" FontWeight="SemiBold" FontSize="15" Foreground="White"/>
            
            <StackPanel Spacing="6">
                <TextBlock Text="SSID (Nazwa sieci WiFi):" FontSize="13" Foreground="LightGray" />
                <TextBox x:Name="SsidTextBox" Watermark="Wprowadź nazwę sieci..." Height="38">
                    <TextBox.InnerLeftContent>
                        <fa:SymbolIcon Symbol="Wifi4" Margin="10,0,0,0" Foreground="Gray"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Hasło WiFi:" FontSize="13" Foreground="LightGray" />
                <TextBox x:Name="PasswordTextBox" PasswordChar="*" Watermark="Wprowadź hasło..." Height="38">
                    <TextBox.InnerLeftContent>
                        <fa:SymbolIcon Symbol="Permissions" Margin="10,0,0,0" Foreground="Gray"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
            </StackPanel>
            
            <StackPanel Spacing="6">
                <TextBlock Text="Adres IP Brokera MQTT (Ten komputer):" FontSize="13" Foreground="LightGray"/>
                <TextBox x:Name="MqttIpTextBox" Watermark="np. 192.168.1.50" Height="38">
                    <TextBox.InnerLeftContent>
                        <fa:SymbolIcon Symbol="Target" Margin="10,0,0,0" Foreground="Gray"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
            </StackPanel>

            <Button Content="Wyślij konfigurację do urządzeń" 
                    Classes="Accent"
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontWeight="Bold"
                    Height="44"
                    CornerRadius="8"
                    Margin="0,15,0,0" 
                    Click="ConnectButton_Click" />
            
            <Button Content="Zmień konfigurację / Resetuj" 
                    Theme="{StaticResource TransparentButton}"
                    HorizontalAlignment="Center" 
                    Foreground="Gray"
                    FontSize="12"
                    Margin="0,5,0,0"
                    Click="ChangeWifiButton_Click" />
        </StackPanel>
        
    </StackPanel>
</Border>
        </ScrollViewer>
        
    </Grid>
</UserControl>