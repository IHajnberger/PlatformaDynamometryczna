<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:scott="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UI_Test_Avalonia.DataView">
    <Grid Margin="10">
        <Grid x:Name="MainPanel" RowDefinitions="Auto, Auto, *">
            
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,10">
                <Button Name="BackButton" VerticalAlignment="Center" Padding="8,5">
                    <fa:SymbolIcon Symbol="Back" FontSize="18"/>
                </Button>
                <TextBlock Text="Live Weight Data" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            
            <TextBlock Grid.Row="1" x:Name="StatusText" Text="Status: Initializing..." Foreground="Gray" Margin="0,0,0,10"/>
            
            <scott:AvaPlot Grid.Row="2" x:Name="WeightPlot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            
        </Grid>

        <TextBlock x:Name="ErrorText" 
                   IsVisible="False" 
                   TextWrapping="Wrap"
                   Foreground="Red"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>