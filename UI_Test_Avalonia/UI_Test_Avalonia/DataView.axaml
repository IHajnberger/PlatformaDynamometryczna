<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:local="clr-namespace:UI_Test_Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="UI_Test_Avalonia.DataView"
             x:DataType="local:DataView">

    <Grid Margin="20" RowDefinitions="Auto, *">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
            <Button Name="BackButton" VerticalAlignment="Center" Classes="ModernCard" Padding="8,6">
                <fa:SymbolIcon Symbol="Back" FontSize="20" Foreground="White"/>
            </Button>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Analiza danych na żywo" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="StatusText" Text="Status: Inicjalizacja..." FontSize="13" Foreground="Gray"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="1*, 3*" Background="Transparent">

            <Grid Grid.Column="0" RowDefinitions="Auto, *" Margin="0,0,15,0">
                <Border Grid.Row="0" Background="#2d2d2d" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
                            <fa:SymbolIcon Symbol="Target" Foreground="#3b82f6" FontSize="16"/>
                            <TextBlock Text="Siła (Live)" FontWeight="Bold" FontSize="14" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <Border Background="#222222" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Peak Force" Foreground="Gray" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SummaryPeakText" Text="-- kg" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border Background="#222222" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Mean Force" Foreground="Gray" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SummaryMeanText" Text="-- kg" FontWeight="Bold" Foreground="#3b82f6" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border Background="#222222" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Min Force" Foreground="Gray" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SummaryMinText" Text="-- kg" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border Background="#222222" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Asymmetry" Foreground="Gray" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SummaryAsymmetryText" Text="--%"  FontWeight="Bold" Foreground="#ef4444" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#2d2d2d" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="12" Padding="15">
                    <Grid RowDefinitions="Auto, *">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <fa:SymbolIcon Symbol="People" Foreground="#10b981" FontSize="16"/>
                            <TextBlock Text="Balans / Model Ciała" FontWeight="Bold" FontSize="14" Foreground="White"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#222222" CornerRadius="8">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                    <fa:SymbolIcon Symbol="Character" FontSize="48" Foreground="Gray"/>
                                    <TextBlock Text="[ Model 3D / Wizualizacja ]" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,10,0,0">
                                        <TextBlock x:Name="BalanceLeftText" Text="L: --%" Foreground="#3b82f6" FontWeight="Bold"/>
                                        <TextBlock x:Name="BalanceRightText" Text="R: --%" Foreground="Orange" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="2*, Auto" Margin="5,0,0,0">
                <Border Grid.Row="0" Background="#2d2d2d" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                    <Grid RowDefinitions="Auto, *">
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Wykresy Siły (Lewa / Prawa noga)" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                            <Button Name="SaveSessionButton" Content="Zapisz Sesję" Classes="ModernCard" CornerRadius="6" Padding="12,5" HorizontalAlignment="Right"/>
                        </DockPanel>
                        
                        <Grid Grid.Row="1" ColumnDefinitions="1*, 1*">
                            
                            <Grid Grid.Column="0" RowDefinitions="*, Auto" Margin="0,0,10,0" Background="Transparent" Name="LeftChartContainer">
                                <lvc:CartesianChart Grid.Row="0"
                                                    Series="{Binding LeftChartSeries}"
                                                    XAxes="{Binding XAxesLeft}"
                                                    YAxes="{Binding YAxes}"
                                                    ZoomMode="X"
                                                    LegendPosition="Hidden"/>
                                <ScrollBar Name="LeftScrollBar" Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0" Height="12" Opacity="0">
                                    <ScrollBar.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                        </Transitions>
                                    </ScrollBar.Transitions>
                                </ScrollBar>
                            </Grid>

                            <Grid Grid.Column="1" RowDefinitions="*, Auto" Margin="10,0,0,0" Background="Transparent" Name="RightChartContainer">
                                <lvc:CartesianChart Grid.Row="0"
                                                    Series="{Binding RightChartSeries}"
                                                    XAxes="{Binding XAxesRight}"
                                                    YAxes="{Binding YAxes}"
                                                    ZoomMode="X"
                                                    LegendPosition="Hidden"/>
                                <ScrollBar Name="RightScrollBar" Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0" Height="12" Opacity="0">
                                    <ScrollBar.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                        </Transitions>
                                    </ScrollBar.Transitions>
                                </ScrollBar>
                            </Grid>
                            
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#2d2d2d" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="12" Padding="15">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                            <fa:SymbolIcon Symbol="Filter" Foreground="#06b6d4" FontSize="14"/>
                            <TextBlock Text="Parametry (Live)" FontWeight="Bold" FontSize="13" Foreground="White"/>
                        </StackPanel>
                        <UniformGrid Columns="4" Rows="2">
                            <Border Background="#222222" CornerRadius="6" Padding="10,8" Margin="0,0,6,6">
                                <DockPanel>
                                    <TextBlock Text="Peak Force L" Foreground="Gray" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PeakForceLText" Text="-- kg" FontWeight="Bold" Foreground="#3b82f6" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border Background="#222222" CornerRadius="6" Padding="10,8" Margin="0,0,6,6">
                                <DockPanel>
                                    <TextBlock Text="Peak Force R" Foreground="Gray" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PeakForceRText" Text="-- kg" FontWeight="Bold" Foreground="#f59e0b" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border Background="#222222" CornerRadius="6" Padding="10,8" Margin="0,0,6,6">
                                <DockPanel>
                                    <TextBlock Text="Mean Force L" Foreground="Gray" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MeanForceLText" Text="-- kg" FontWeight="Bold" Foreground="#3b82f6" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border Background="#222222" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock Text="Mean Force R" Foreground="Gray" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MeanForceRText" Text="-- kg" FontWeight="Bold" Foreground="#f59e0b" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border Background="#222222" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <DockPanel>
                                    <TextBlock Text="Load Ratio" Foreground="Gray" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LoadRatioText" Text="L:-- R:--" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border Background="#222222" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <DockPanel>
                                    <TextBlock Text="Asymmetry" Foreground="Gray" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AsymmetryText" Text="--%"  FontWeight="Bold" Foreground="#ef4444" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border Background="#222222" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                <DockPanel>
                                    <TextBlock Text="Flight Time" Foreground="Gray" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FlightTimeText" Text="-- s" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border Background="#222222" CornerRadius="6" Padding="10,8" Margin="0">
                                <DockPanel>
                                    <TextBlock Text="Braking RFD" Foreground="Gray" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BrakingRFDText" Text="-- kg/s" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>