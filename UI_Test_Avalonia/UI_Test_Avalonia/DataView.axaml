<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:local="clr-namespace:UI_Test_Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="UI_Test_Avalonia.DataView"
             x:DataType="local:DataView">

    <Grid Margin="20" RowDefinitions="Auto, *">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,20">
            <Button Name="BackButton" VerticalAlignment="Center" Classes="ModernCard" Padding="8,6">
                <fa:SymbolIcon Symbol="Back" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Analiza danych na żywo" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="StatusText" Text="Status: Inicjalizacja..." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="1*, 3*" Background="Transparent">

            <Grid Grid.Column="0" RowDefinitions="Auto, Auto, *" Margin="0,0,15,0">

                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fa:SymbolIcon Symbol="People" Foreground="#10b981" FontSize="14"/>
                            <TextBlock Text="Sesja" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                            <DockPanel>
                                <TextBlock Text="Pacjent" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock x:Name="SessionPatientText" Text="Nie wybrano" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" Foreground="Orange"/>
                            </DockPanel>
                        </Border>
                        <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                            <DockPanel>
                                <TextBlock Text="Ćwiczenie" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock x:Name="SessionExerciseText" Text="Nie wybrano" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" Foreground="Orange"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,10">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
                            <fa:SymbolIcon Symbol="Target" Foreground="#3b82f6" FontSize="16"/>
                            <TextBlock Text="Siła (Live)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Peak Force" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SummaryPeakText" Text="-- kg" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Mean Force" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SummaryMeanText" Text="-- kg" FontWeight="Bold" Foreground="#3b82f6" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Min Force" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SummaryMinText" Text="-- kg" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Asymmetry" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SummaryAsymmetryText" Text="--%"  FontWeight="Bold" Foreground="#ef4444" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                <fa:SymbolIcon Symbol="Filter" Foreground="#06b6d4" FontSize="14"/>
                                <TextBlock Text="Parametry (Live)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <Border x:Name="ParamPeakForceL" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Peak Force L" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PeakForceLText" Text="-- kg" FontWeight="Bold" Foreground="#3b82f6" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="ParamPeakForceR" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Peak Force R" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PeakForceRText" Text="-- kg" FontWeight="Bold" Foreground="#f59e0b" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="ParamMeanForceL" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Mean Force L" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MeanForceLText" Text="-- kg" FontWeight="Bold" Foreground="#3b82f6" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="ParamMeanForceR" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Mean Force R" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MeanForceRText" Text="-- kg" FontWeight="Bold" Foreground="#f59e0b" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="ParamLoadRatio" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Load Ratio" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LoadRatioText" Text="L:-- R:--" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="ParamAsymmetry" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Asymmetry" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="AsymmetryText" Text="--%"  FontWeight="Bold" Foreground="#ef4444" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                       
                            <Border x:Name="ParamRFD" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="RFD" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RFDText" Text="-- kg/s" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="ParamTotalForce" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Total Force" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TotalForceText" Text="-- kg" FontWeight="Bold" Foreground="#22c55e" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="ParamStabilityIndex" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Stability Index" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StabilityIndexText" Text="--" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="ParamStabilizationTime" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Stabilization Time" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StabilizationTimeText" Text="-- s" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="ParamTimeToPeak" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Time To Peak" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TimeToPeakText" Text="-- s" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="ParamTransferSpd" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Transfer Speed" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TransferSpeedText" Text="-- kg/s" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="ParamSwayVelocity" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Sway Velocity" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SwayVelocityText" Text="--" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="ParamForceVariability" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Force Variability" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ForceVariabilityText" Text="--" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="ParamControlScore" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Control Score" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ControlScoreText" Text="-- %" FontWeight="Bold" Foreground="#8b5cf6" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                            <Border x:Name="ParamFatigueIndex" Background="{DynamicResource AppBackgroundBrush}" CornerRadius="6" Padding="10,8">
                                <DockPanel>
                                    <TextBlock Text="Fatigue Index" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FatigueIndexText" Text="-- %" FontWeight="Bold" Foreground="#ef4444" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>

            <Grid Grid.Column="1" RowDefinitions="*, Auto" Margin="5,0,0,0">

                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                    <Grid RowDefinitions="Auto, *">
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Wykresy Siły (Lewa / Prawa noga)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="SaveSessionButton" Content="Zapisz Sesję" Classes="ModernCard" CornerRadius="6" Padding="12,5" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <Grid Grid.Row="1" ColumnDefinitions="1*, 1*">
                            <Grid Grid.Column="0" RowDefinitions="*, Auto" Margin="0,0,10,0" Background="Transparent" Name="LeftChartContainer">
                                <lvc:CartesianChart Grid.Row="0"
                                                    Series="{Binding LeftChartSeries}"
                                                    XAxes="{Binding XAxesLeft}"
                                                    YAxes="{Binding YAxes}"
                                                    ZoomMode="X"
                                                    LegendPosition="Hidden"/>
                                <ScrollBar Name="LeftScrollBar" Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0" Height="12" Opacity="0">
                                    <ScrollBar.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                        </Transitions>
                                    </ScrollBar.Transitions>
                                </ScrollBar>
                            </Grid>
                            <Grid Grid.Column="1" RowDefinitions="*, Auto" Margin="10,0,0,0" Background="Transparent" Name="RightChartContainer">
                                <lvc:CartesianChart Grid.Row="0"
                                                    Series="{Binding RightChartSeries}"
                                                    XAxes="{Binding XAxesRight}"
                                                    YAxes="{Binding YAxes}"
                                                    ZoomMode="X"
                                                    LegendPosition="Hidden"/>
                                <ScrollBar Name="RightScrollBar" Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0" Height="12" Opacity="0">
                                    <ScrollBar.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                        </Transitions>
                                    </ScrollBar.Transitions>
                                </ScrollBar>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="15" MinHeight="80">
                <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <fa:SymbolIcon Symbol="Clock" Foreground="#06b6d4" FontSize="20"/>
                        <TextBlock x:Name="SessionTimerText" Text="00:00:00" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>

                    <Border Grid.Column="1"/>

                    <Button Grid.Column="2"
                            x:Name="MarkPeakButton"
                            Classes="ModernCard"
                            Padding="16,10"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fa:SymbolIcon Symbol="Flag" Foreground="#ef4444" FontSize="16"/>
                            <TextBlock Text="Zaznacz Peak" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            x:Name="StopSessionButton"
                            Classes="ModernCard"
                            Padding="16,10"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fa:SymbolIcon Symbol="Stop" Foreground="#f59e0b" FontSize="16"/>
                            <TextBlock Text="Stop" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4"
                            x:Name="ClearAllButton"
                            Classes="ModernCard"
                            Padding="16,10"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fa:SymbolIcon Symbol="Delete" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16"/>
                            <TextBlock Text="Usuń" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                </Grid>
            </Border>

            </Grid>
        </Grid>
    </Grid>
</UserControl>