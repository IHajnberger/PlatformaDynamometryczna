<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI_Test_Avalonia"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="UI_Test_Avalonia.MainWindow"
        Title="PhysioFlow" 
        Width="1500" Height="1000"
        Background="{DynamicResource SystemRegionBrush}">
    
    <DockPanel>
        <!-- GÓRNY PASEK NAWIGACYJNY -->
        <Border DockPanel.Dock="Top" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                Padding="15,10" 
                BorderBrush="{DynamicResource SystemControlGridLinesBrush}" 
                BorderThickness="0,0,0,1">
            
            <Grid ColumnDefinitions="Auto, *">
                <!-- Nazwa aplikacji po lewej stronie -->
                <TextBlock Grid.Column="0" 
                           Text="Placeholder" 
                           FontWeight="Bold" 
                           FontSize="20" 
                           VerticalAlignment="Center" 
                           Margin="0,0,30,0"/>
                
            </Grid>
        </Border>

        <!-- GŁÓWNA ZAWARTOŚĆ PONIŻEJ MENU -->
        <!-- Ten element automatycznie zajmie całą resztę ekranu pod menu -->
        <ContentControl x:Name="MainContentArea" Padding="20">
            <local:HomeView/>
        </ContentControl>
    </DockPanel>
    
</Window>