<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:local="clr-namespace:UI_Test_Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="UI_Test_Avalonia.PatientsListView">

    <UserControl.Styles>
        <Style Selector="Button.DashboardCard">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DashboardCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
        </Style>
        <Style Selector="Button.DashboardCard:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.DashboardCard:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
            <Setter Property="BorderBrush" Value="#3b82f6"/>
        </Style>
        <Style Selector="Button.DashboardCard:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
    </UserControl.Styles>

    <Grid>

        <Grid Margin="30" RowDefinitions="Auto, Auto, *">

            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,20">
                <Button Grid.Column="0" Name="BackButton" VerticalAlignment="Center" Classes="ModernCard" Padding="12,8">
                    <fa:SymbolIcon Symbol="Back" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="15,0">
                    <TextBlock x:Name="StatusText" Text="Lista pacjentów" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SubStatusText" Text="Zarządzaj kartoteką pacjentów" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Name="AddPatientButton"
                        VerticalAlignment="Center"
                        Padding="14,10"
                        CornerRadius="10"
                        Background="#3b82f6"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <fa:SymbolIcon Symbol="Add" FontSize="16" Foreground="White"/>
                        <TextBlock Text="Dodaj pacjenta" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PatientListPanel" Spacing="10" MaxWidth="1100" HorizontalAlignment="Stretch"/>
            </ScrollViewer>

        </Grid>

        <Grid x:Name="AddPatientOverlay" IsVisible="False">
            <Border Background="#000000" Opacity="0.6"/>
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="32"
                    MaxWidth="480"
                    MaxHeight="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="20">

                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Nowy pacjent" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Wypełnij podstawowe dane" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Name="CloseOverlayButton"
                                Classes="ModernCard" Padding="8" VerticalAlignment="Top">
                            <fa:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Imię i nazwisko" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="NewPatientName" Watermark="np. Jan Kowalski" Height="38" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Data urodzenia" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="NewPatientDob" Watermark="RRRR-MM-DD" Height="38" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Numer telefonu" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="NewPatientPhone" Watermark="np. +48 600 000 000" Height="38" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Notatka wstępna" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="NewPatientNote"
                                 Watermark="np. kontuzja kolana, rehabilitacja po operacji..."
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="80"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>

                    <Button Name="ConfirmAddButton"
                            HorizontalAlignment="Stretch"
                            Height="42"
                            CornerRadius="10"
                            Background="#3b82f6"
                            BorderThickness="0">
                        <TextBlock Text="Dodaj pacjenta" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Button>

                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>