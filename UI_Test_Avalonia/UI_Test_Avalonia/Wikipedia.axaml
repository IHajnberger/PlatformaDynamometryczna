<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="UI_Test_Avalonia.Wikipedia">

    <UserControl.Styles>
        <Style Selector="Button.DashboardCard">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="BorderBrush" Value="#3d3d3d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DashboardCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#373737"/>
            <Setter Property="BorderBrush" Value="#4f4f4f"/>
        </Style>
        <Style Selector="Button.DashboardCard:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.DashboardCard:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderBrush" Value="#3b82f6"/>
        </Style>
        <Style Selector="Button.DashboardCard:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="30" RowDefinitions="Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,25">
            <Button Grid.Column="0" Name="BackButton" VerticalAlignment="Center" Classes="ModernCard" Padding="12,8">
                <fa:SymbolIcon Symbol="Back" FontSize="20" Foreground="White"/>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="15,0">
                <TextBlock Text="Baza wiedzy" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Protokoły testów i opisy ćwiczeń" FontSize="13" Foreground="Gray"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch" Margin="0,0,0,20">

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <fa:SymbolIcon Symbol="Library" FontSize="18" Foreground="#8b5cf6"/>
                    <TextBlock Text="Testy dynamometryczne" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Statyczny rozkład ciężaru -->
                <Button Name="TileSRCL" Classes="DashboardCard">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                Background="#1d3a6e" Margin="0,0,18,0" VerticalAlignment="Center">
                            <fa:SymbolIcon Symbol="People" FontSize="24" Foreground="#3b82f6"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Statyczny rozkład ciężaru" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <Border Background="#1d3a6e" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Static Weight Distribution" FontSize="11" Foreground="#3b82f6"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="placeholder" FontSize="13" Foreground="Gray" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Clock" FontSize="12" Foreground="#10b981"/>
                                    <TextBlock Text="~3 min" FontSize="12" Foreground="#10b981"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Target" FontSize="12" Foreground="Gray"/>
                                    <TextBlock Text="Asymetria L:R" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Flag" FontSize="12" Foreground="#f59e0b"/>
                                    <TextBlock Text="4 fazy analizy" FontSize="12" Foreground="#f59e0b"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <fa:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="18" Foreground="Gray" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <!-- Próba jednonożna Lewa Noga -->
                <Button Name="TilePJL" Classes="DashboardCard">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                Background="#2d1b4e" Margin="0,0,18,0" VerticalAlignment="Center">
                            <fa:SymbolIcon Symbol="Star" FontSize="24" Foreground="#8b5cf6"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Próba jednonożna lewa noga" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <Border Background="#2d1b4e" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Single Leg Stance Left" FontSize="11" Foreground="#8b5cf6"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="placeholder" FontSize="13" Foreground="Gray" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Clock" FontSize="12" Foreground="Gray"/>
                                    <TextBlock Text="~2 min" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Target" FontSize="12" Foreground="Gray"/>                                    <TextBlock Text="Skurcz statyczny" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <Border Background="#2d2d2d" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Wkrótce" FontSize="11" Foreground="Gray"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <fa:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="18" Foreground="Gray" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- Próba jednonożna Prawa Noga -->
                <Button Name="TilePJP" Classes="DashboardCard">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                Background="#a66802" Margin="0,0,18,0" VerticalAlignment="Center">
                            <fa:SymbolIcon Symbol="WeatherSunny" FontSize="24" Foreground="#de9d2f"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Próba jednonożna prawa noga" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <Border Background="#a66802" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Single Leg Stance Right" FontSize="11" Foreground="#de9d2f"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Izolowana ocena maksymalnej siły koncentrycznej bez ruchu w stawach pod stałym oporem – wkrótce dostępne." FontSize="13" Foreground="Gray" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Clock" FontSize="12" Foreground="Gray"/>
                                    <TextBlock Text="~2 min" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Target" FontSize="12" Foreground="Gray"/>                                    <TextBlock Text="Skurcz statyczny" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <Border Background="#2d2d2d" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Wkrótce" FontSize="11" Foreground="Gray"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <fa:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="18" Foreground="Gray" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- Test wstawania i siadania -->
                <Button Name="TileTWiS" Classes="DashboardCard">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                Background="#0c6e36" Margin="0,0,18,0" VerticalAlignment="Center">
                            <fa:SymbolIcon Symbol="CalendarDay" FontSize="24" Foreground="#1ca657"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Test wstawania i siadania" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <Border Background="#0c6e36" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Sit To Stand" FontSize="11" Foreground="#1ca657"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Izolowana ocena maksymalnej siły koncentrycznej bez ruchu w stawach pod stałym oporem – wkrótce dostępne." FontSize="13" Foreground="Gray" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Clock" FontSize="12" Foreground="Gray"/>
                                    <TextBlock Text="~2 min" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Target" FontSize="12" Foreground="Gray"/>                                    <TextBlock Text="Skurcz statyczny" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <Border Background="#2d2d2d" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Wkrótce" FontSize="11" Foreground="Gray"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <fa:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="18" Foreground="Gray" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- Przysiad obustronny -->
                <Button Name="TilePO" Classes="DashboardCard">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                Background="#701e4b" Margin="0,0,18,0" VerticalAlignment="Center">
                            <fa:SymbolIcon Symbol="Contact" FontSize="24" Foreground="#b54a85"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Przysiad obustronny" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <Border Background="#701e4b" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Squat Assessment" FontSize="11" Foreground="#b54a85"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Izolowana ocena maksymalnej siły koncentrycznej bez ruchu w stawach pod stałym oporem – wkrótce dostępne." FontSize="13" Foreground="Gray" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Clock" FontSize="12" Foreground="Gray"/>
                                    <TextBlock Text="~2 min" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Target" FontSize="12" Foreground="Gray"/>                                    <TextBlock Text="Skurcz statyczny" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <Border Background="#2d2d2d" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Wkrótce" FontSize="11" Foreground="Gray"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <fa:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="18" Foreground="Gray" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- Próba Romberga -->
                <Button Name="TilePR" Classes="DashboardCard">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                Background="#611d19" Margin="0,0,18,0" VerticalAlignment="Center">
                            <fa:SymbolIcon Symbol="Page" FontSize="24" Foreground="#a34540"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Próba Romberga" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <Border Background="#611d19" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Balance Test (Romberg)" FontSize="11" Foreground="#a34540"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Izolowana ocena maksymalnej siły koncentrycznej bez ruchu w stawach pod stałym oporem – wkrótce dostępne." FontSize="13" Foreground="Gray" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Clock" FontSize="12" Foreground="Gray"/>
                                    <TextBlock Text="~2 min" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Target" FontSize="12" Foreground="Gray"/>                                    <TextBlock Text="Skurcz statyczny" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <Border Background="#2d2d2d" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Wkrótce" FontSize="11" Foreground="Gray"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <fa:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="18" Foreground="Gray" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- Test wytrzymałości izometrycznej -->
                <Button Name="TileTWiI" Classes="DashboardCard">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                Background="#09543f" Margin="0,0,18,0" VerticalAlignment="Center">
                            <fa:SymbolIcon Symbol="List" FontSize="24" Foreground="#379e81"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Test wytrzymałości izometrycznej" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <Border Background="#09543f" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Isometric Strength Test" FontSize="11" Foreground="#379e81"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Izolowana ocena maksymalnej siły koncentrycznej bez ruchu w stawach pod stałym oporem – wkrótce dostępne." FontSize="13" Foreground="Gray" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Clock" FontSize="12" Foreground="Gray"/>
                                    <TextBlock Text="~2 min" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:SymbolIcon Symbol="Target" FontSize="12" Foreground="Gray"/>                                    <TextBlock Text="Skurcz statyczny" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <Border Background="#2d2d2d" BorderBrush="#3d3d3d" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="Wkrótce" FontSize="11" Foreground="Gray"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <fa:SymbolIcon Grid.Column="2" Symbol="ChevronRight" FontSize="18" Foreground="Gray" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>